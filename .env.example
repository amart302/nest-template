# Application
PORT=3001

# Database
DATABASE_USER=app_user
DATABASE_PASSWORD=app_db_password
DATABASE_NAME=app_db
DATABASE_URL=postgresql://app_user:app_db_password@localhost:5432/app_db

# JWT
JWT_ACCESS_SECRET=access_token_secret
JWT_ACCESS_EXPIRES_IN=86400

# CORS
FRONTEND_URL=http://localhost:3000